{
  "name": "starr-surveying",
  "version": "1.0.0",
  "description": "Professional Land Surveying Website - TypeScript/NextJS",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:desktop": "node scripts/prepare-desktop-build.mjs run -- next build",
    "build:desktop:stash": "node scripts/prepare-desktop-build.mjs stash",
    "build:desktop:restore": "node scripts/prepare-desktop-build.mjs restore",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:inline-style-hex": "tsx scripts/scan-inline-style-hex.ts",
    "verify:org-scope": "node scripts/verify-org-scoped-tables.mjs",
    "scan:untranslated": "tsx scripts/scan-untranslated.ts",
    "audit:mobile": "node scripts/audit-mobile.mjs",
    "migrate:dnd-content": "tsx scripts/migrate-dnd-content.ts",
    "verify:fs-figures": "tsx scripts/verify-fs-figures.ts",
    "verify:fs-questions": "tsx scripts/verify-fs-questions.ts",
    "design:import": "node --env-file=.env.local scripts/design-import-page.mjs",
    "design:coverage": "node --env-file=.env.local scripts/design-coverage-sweep.mjs",
    "design:check": "node --env-file=.env.local scripts/check-design-studio.mjs",
    "import:bestiary": "npx --yes vite-node -c vitest.config.ts scripts/import-bestiary.mjs --",
    "import:bestiary:pf2": "npx --yes vite-node -c vitest.config.ts scripts/import-bestiary-pf2.mjs --",
    "art:creatures": "npx --yes vite-node -c vitest.config.ts scripts/fetch-creature-art.mjs --",
    "variants:creatures": "npx --yes vite-node -c vitest.config.ts scripts/generate-creature-variants.mjs --",
    "audit:bestiary": "node scripts/audit-bestiary.mjs",
    "db:seed": "node scripts/apply-seeds.mjs",
    "db:seed:all": "node scripts/apply-seeds.mjs --continue-on-error",
    "db:seed:reset": "node scripts/apply-seeds.mjs --reset",
    "db:seed:staging": "node scripts/apply-seeds.mjs --target staging",
    "db:bootstrap:staging": "node scripts/apply-seeds.mjs --target staging --reset --continue-on-error",
    "db:seed:dry": "node scripts/apply-seeds.mjs --dry-run",
    "db:embed": "node scripts/embed-documents.mjs",
    "db:embed:dry": "node scripts/embed-documents.mjs --dry-run",
    "dnd:bootstrap": "node scripts/dnd-bootstrap.mjs",
    "dnd:seed-lazzuh": "tsx scripts/dnd-seed-lazzuh.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "ws": "tsx server/ws.ts",
    "generate:bestiary": "npx --yes vite-node -c vitest.config.ts scripts/generate-transposed-bestiary.mjs --",
    "import:open5e": "npx --yes vite-node -c vitest.config.ts scripts/import-open5e.mjs --",
    "derive:tiers": "node scripts/derive-tier-tables.mjs",
    "audit:natives": "npx --yes vite-node -c vitest.config.ts scripts/audit-native-coverage.mjs --"
  },
