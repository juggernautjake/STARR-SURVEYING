# Scratch / temp scripting from content-buildout sessions (not source).
scripts/_tmp_landlaw/

# Supabase CLI per-developer link state (project ref, pooler URL, version pins).
supabase/.temp/

# Playwright MCP screenshots + per-session audit artifacts (local only).
audit-*.png
.playwright-mcp/

# Scratch concatenated SQL / generated build artifacts. Anything in tmp/
# is a one-shot blob (e.g. seeds_*_to_*.sql for the Supabase web SQL
# editor) — the canonical source stays in seeds/.
tmp/

dev-server.log

.playwright-mcp/
*.png

# Local audit artefacts — screenshots + token dumps from scripts/contact-sheet.mjs and audit-mobile.mjs.
# Evidence for a slice, not source: regenerate with `node scripts/contact-sheet.mjs`.
.audit/
.cache/
scripts/_tmp_map/

# Design Studio raw scan output — regenerable by scripts/design-catalogue-scan.mjs (7 MB), and
# derived from code, so it must never be the thing anybody edits or reviews. The CURATED
# catalogue under lib/design/catalogue/curated/ is committed; this is not.
lib/design/catalogue/raw/
scripts/_tmp_*

# Generated by scripts/ui-fit-sweep.mjs — a measurement of one run, not a source file.
ui-fit-report.json
ui-fit-shots/
_tmp_*
